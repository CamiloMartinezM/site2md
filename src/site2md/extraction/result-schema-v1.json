{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:site2md:extraction-result:v1",
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_section",
        "source",
        "start",
        "end",
        "start_line",
        "end_line"
      ],
      "properties": {
        "source_section": {"type": "integer", "minimum": 0},
        "source": {"type": ["string", "null"]},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_section",
        "source",
        "start",
        "end",
        "start_line",
        "end_line",
        "spans"
      ],
      "properties": {
        "source_section": {"type": "integer", "minimum": 0},
        "source": {"type": ["string", "null"]},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/span"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "extractor",
    "provider",
    "record_schema",
    "input_digest",
    "source_sections",
    "records",
    "diagnostics"
  ],
  "properties": {
    "format_version": {"const": 1},
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interface_version", "implementation_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "interface_version": {"const": 1},
        "implementation_version": {"type": "string", "minLength": 1}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version"],
      "properties": {
        "distribution": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "record_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "source"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "source": {"type": ["string", "null"]}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "provenance"],
        "properties": {
          "value": {"type": "object"},
          "provenance": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message", "provenance"],
        "properties": {
          "severity": {"enum": ["warning", "error"]},
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "array",
            "items": {"$ref": "#/$defs/span"}
          }
        }
      }
    }
  }
}
